{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "outputs",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/xueqiu-stock-report.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
